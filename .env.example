# ---- Database (Vercel Postgres / Neon / Supabase) ----
# Vercel's Storage tab injects these automatically on deploy.
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
# Optional: non-pooled URL, used by `prisma migrate` / `prisma db push`.
DIRECT_DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# ---- Admin viewer ----
# The single shared password for /admin. Change this.
ADMIN_PASSWORD="change-me"

# ---- Re-skinning the site for the next unlucky friend ----
NEXT_PUBLIC_FRIEND_NAME="Rahul"
NEXT_PUBLIC_INJURY="leg surgery"
NEXT_PUBLIC_SURGERY_DATE="2026-08-20"
# Optional: powers the "days until freedom" countdown. Leave blank to hide it.
NEXT_PUBLIC_FOLLOWUP_DATE="2026-10-01"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
